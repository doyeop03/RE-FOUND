# ── 브라우저 번들에 들어가는 공개 값 (NEXT_PUBLIC_) ──
# Firebase 콘솔 > 프로젝트 설정 > 내 앱(웹) > SDK 설정 및 구성
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# Google Cloud 콘솔 > reCAPTCHA Enterprise > 키 (웹, GitHub Pages 도메인 등록)
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=
# 이미지 입력을 지원하는 Firebase AI Logic 모델 (비우면 gemini-4-hydrogen)
NEXT_PUBLIC_GEMINI_MODEL=
# 로컬 개발(next dev)에서만 App Check 디버그 토큰 사용. 배포 빌드에서는 무시됨
NEXT_PUBLIC_APPCHECK_DEBUG=false

# Supabase 대시보드 > Project Settings > API (anon / publishable 키만!)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── 로컬 전용 비밀 값 (절대 NEXT_PUBLIC_ 접두사 금지 · 커밋 금지) ──
# scripts/register-product.mjs 에서만 사용
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── 로컬 전용 간편 모드 ──
# 값을 넣으면 Firebase · App Check 없이 Gemini API 를 직접 호출한다.
# NEXT_PUBLIC_ 이라 빌드 결과물에 키가 그대로 들어간다.
# 배포(GitHub Pages)는 저장소 Secret GEMINI_API_KEY 로 같은 값을 넣는다 — 키에 도메인(HTTP 리퍼러) 제한을 걸어 둘 것
NEXT_PUBLIC_GEMINI_API_KEY=
